{
    "name": "cx-engine/expert-statistics",
    "description": "Dashboard and Expert Statistics (PBX call analytics) package for BlueRockTEL CX Engine apps.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "livewire/livewire": "^3.0",
        "filament/notifications": "^4.0",
        "blade-ui-kit/blade-heroicons": "^2.5",
        "cx-engine/expert-stats-api-sdk-php": "dev-main",
        "nesbot/carbon": "^2.72|^3.0",
        "prism-php/prism": "^0.99.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "orchestra/testbench": "^9.0|^10.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:CX-engine/expert-stats-api-sdk-php.git",
            "no-api": true
        }
    ],
    "autoload": {
        "psr-4": {
            "CXEngine\\ExpertStatistics\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CXEngine\\ExpertStatistics\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CXEngine\\ExpertStatistics\\ExpertStatisticsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
